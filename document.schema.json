{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.example/textbook-document.schema.json",
  "title": "Textbook PDF structured document",
  "type": "object",
  "required": ["schema_version", "document_id", "source", "page_count", "pages", "review_summary"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "document_id": {"type": "string", "minLength": 1},
    "source": {
      "type": "object",
      "required": ["filename", "sha256"],
      "properties": {
        "filename": {"type": "string"},
        "absolute_path": {"type": "string"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "page_count": {"type": "integer", "minimum": 0},
    "pages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["page", "pdf_size", "render_size", "rotation", "elements"],
        "properties": {
          "page": {"type": "integer", "minimum": 1},
          "elements": {
            "type": "array",
            "items": {"$ref": "#/$defs/element"}
          }
        }
      }
    },
    "review_summary": {"type": "object"}
  },
  "$defs": {
    "element": {
      "type": "object",
      "required": ["id", "type", "page", "reading_order", "bbox", "normalized_bbox", "text", "extraction_method", "confidence", "review_required", "review_reasons", "asset_path"],
      "properties": {
        "id": {"type": "string"},
        "type": {"enum": ["title", "heading", "paragraph", "caption", "image", "table", "music_score", "header", "footer", "page_number", "unknown"]},
        "page": {"type": "integer", "minimum": 1},
        "reading_order": {"type": "integer", "minimum": 1},
        "bbox": {"$ref": "#/$defs/box"},
        "normalized_bbox": {"$ref": "#/$defs/normalizedBox"},
        "text": {"type": "string"},
        "extraction_method": {"type": "string"},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "review_required": {"type": "boolean"},
        "review_reasons": {"type": "array"},
        "asset_path": {"type": ["string", "null"]}
      }
    },
    "box": {
      "type": "array", "minItems": 4, "maxItems": 4,
      "items": {"type": "number", "minimum": 0}
    },
    "normalizedBox": {
      "type": "array", "minItems": 4, "maxItems": 4,
      "items": {"type": "number", "minimum": 0, "maximum": 1}
    }
  }
}
